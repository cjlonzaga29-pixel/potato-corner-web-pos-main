# Database (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DIRECT_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
TEST_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres_test

# Supabase
SUPABASE_URL=https://[PROJECT].supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# JWT (RS256 keypair) — JWT_SECRET does not exist here: auth is RS256
# (JWT_PRIVATE_KEY/JWT_PUBLIC_KEY), and the refresh token is an opaque
# random string, not a JWT. JWT_REFRESH_SECRET is only a boot-time schema
# gate (config/index.ts, min 32 chars), never itself used to sign anything.
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
JWT_REFRESH_SECRET=your_refresh_secret_at_least_32_characters_long

# Encryption
ENCRYPTION_KEY=your_32_byte_hex_encryption_key_here
HASH_KEY=your_32_byte_base64_hmac_key_here

# Redis
REDIS_URL=redis://:[PASSWORD]@[HOST]:6379

# Email (Resend)
RESEND_API_KEY=re_your_resend_key_here

# App
NODE_ENV=development
PORT=3001

# Timezone — defense-in-depth only. Philippine business-date math (dashboard
# windows, reports, EOD summaries, fraud rules, receipt-number date prefixes)
# is computed explicitly against Asia/Manila in code (apps/api/src/lib/manila-time.ts)
# and never relies on the process TZ. Set this anyway so any library or new
# code path that does read local time falls back to the correct zone instead
# of server-local/UTC. The production Render service must set TZ=Asia/Manila.
TZ=Asia/Manila

# Sentry (optional)
SENTRY_DSN=https://[KEY]@sentry.io/[PROJECT]

# POS checkout transaction limits (optional — defaults shown)
PRISMA_TRANSACTION_MAX_WAIT_MS=10000
PRISMA_TRANSACTION_TIMEOUT_MS=30000
