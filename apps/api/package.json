{
  "name": "@potato-corner/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "inventory:migration:dry-run": "tsx scripts/inventory-migration-dry-run.ts",
    "inventory:reference-init:dry-run": "tsx scripts/inventory-reference-init-dry-run.ts",
    "inventory:reference-init:apply": "tsx scripts/inventory-reference-init-apply.ts",
    "inventory:reference-init:rollback-assess": "tsx scripts/inventory-reference-init-rollback-assess.ts",
    "inventory:reference-init:rollback-execute": "tsx scripts/inventory-reference-init-rollback-execute.ts",
    "initialization:reconcile": "tsx scripts/initialization-reconcile.ts",
    "inventory:projection:drain": "tsx scripts/inventory-projection-drain.ts",
    "inventory:reconciliation:report": "tsx scripts/inventory-reconciliation-report.ts",
    "inventory:rebuild:dry-run": "tsx scripts/inventory-rebuild-dry-run.ts",
    "inventory:rebuild:confirm": "tsx scripts/inventory-rebuild-confirm.ts",
    "shadow-bom-deduction:report": "tsx scripts/shadow-bom-deduction-report.ts",
    "validate:inventory-setup": "tsx scripts/validate-inventory-setup.ts",
    "generate:inventory-workbook": "tsx scripts/generate-inventory-workbook.ts",
    "sync:inventory-workbook:check": "tsx scripts/sync-inventory-workbook-to-csv.ts --check",
    "sync:inventory-workbook:preview": "tsx scripts/sync-inventory-workbook-to-csv.ts --preview",
    "sync:inventory-workbook:write": "tsx scripts/sync-inventory-workbook-to-csv.ts --write"
  },
  "dependencies": {
    "@potato-corner/shared": "workspace:*",
    "@prisma/client": "^5.22.0",
    "@react-pdf/renderer": "^4.1.6",
    "@sentry/node": "^8.47.0",
    "@supabase/supabase-js": "^2.47.10",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.0.1",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.2.0",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "resend": "^4.0.1",
    "sharp": "^0.35.3",
    "socket.io": "^4.8.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@potato-corner/config": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@vitest/coverage-v8": "^3.0.2",
    "bcryptjs": "^3.0.3",
    "eslint": "^9.18.0",
    "exceljs": "^4.4.0",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
