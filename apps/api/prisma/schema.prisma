datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------
// Native Prisma enums (not String + CHECK): gives Postgres-level CREATE TYPE
// validation and doesn't conflict with the app-code "no hand-written TS enum"
// rule — Prisma-generated enums compile to string-literal unions.

enum Role {
  super_admin
  supervisor
  branch
  staff
}

// Branch Operating System (CR-003): lifecycle status for User rows tied to
// an employee record (branch + staff roles). Distinct from the older
// isActive boolean, which stays in sync (isActive = status == active) for
// existing consumers — status is the authoritative field for login gating
// and forced session invalidation.
enum EmployeeStatus {
  active
  inactive
  suspended
  resigned
  terminated
}

enum EmploymentType {
  regular
  contractual
  part_time
}

enum BranchStatus {
  active
  inactive
  closed
}

enum ProductStatus {
  draft
  active
  temporarily_unavailable
  discontinued
  archived
}

enum TransactionStatus {
  completed
  voided
  refunded
}

enum PaymentMethod {
  cash
  gcash
  maya
  other
}

enum InventoryDeductionStatus {
  pending
  completed
  failed
}

enum HoldOrderStatus {
  held
  released
  expired
}

enum ShiftStatus {
  active
  closed
  flagged
}

enum DenominationCountType {
  opening
  closing
}

enum MovementType {
  stock_in
  sale_deduction
  manual_adjustment
  waste
  physical_count
  transfer_in
  transfer_out
}

enum ImageProofType {
  live_capture
  gallery_upload
}

enum AttendanceGpsStatus {
  within_radius
  outside_radius
  no_gps_data
}

enum AttendanceStatus {
  present
  corrected
}

enum FraudAlertSeverity {
  low
  medium
  high
  critical
}

enum FraudAlertStatus {
  open
  investigating
  dismissed
  escalated
}

enum ExpenseCategory {
  utilities
  supplies
  staff_meals
  miscellaneous
}

// CR-005 Phase 1 — Product Builder & Recipe Composition Engine foundations.
enum IngredientCategory {
  RAW
  FLAVOR
  CUP
  BAG
  PACKAGING
  OTHER
}

enum VariantLifecycleStatus {
  DRAFT
  PENDING_APPROVAL
  ACTIVE
  ARCHIVED
}

enum InventoryMappingStatus {
  PENDING
  AUTO_MATCHED
  MANUALLY_MATCHED
  AMBIGUOUS
  REJECTED
}

enum InventoryMappingMethod {
  NORMALIZED_NAME_UNIT_CATEGORY
  FLAVOR_IDENTITY
  MANUAL
  IMPORT
}

enum UnitDimension {
  WEIGHT
  VOLUME
  COUNT
}

// CR-008 -- generic selection rule for a Product Option Group (e.g. Flavor,
// Size, Add-ons). SINGLE = radio-button choice, MULTIPLE = checkbox choice
// bounded by minSelections/maxSelections.
enum ProductOptionSelectionType {
  SINGLE
  MULTIPLE
}

// CR-009 -- durable initialization audit/provenance infrastructure for the
// future reference-data initialization system (categories/units/conversions).
// Single value today; kept as an enum (not a free string) for future
// extensibility per CR-009's decision doc.
enum InitializationType {
  REFERENCE_DATA
}

enum InitializationExecutionMode {
  DRY_RUN
  APPLY
  ROLLBACK
}

enum InitializationRunStatus {
  PLANNED
  DRY_RUN_VALIDATED
  APPLYING
  APPLIED
  APPLY_FAILED
  ROLLBACK_ASSESSING
  ROLLBACK_BLOCKED
  ROLLING_BACK
  ROLLED_BACK
  ROLLBACK_PARTIAL
  SUPERSEDED
}

enum InitializationEntityType {
  INVENTORY_CATEGORY
  UNIT_OF_MEASURE
  UNIT_CONVERSION
}

// VALIDATED is the dry-run-created initial action per CR-009.2's locked
// lifecycle model: a dry-run row is created with action = VALIDATED before
// apply transitions it to CREATED/REUSED/SKIPPED/BLOCKED/FAILED.
enum InitializationAction {
  VALIDATED
  CREATED
  REUSED
  SKIPPED
  BLOCKED
  FAILED
}

// Nullable on InitializationRecord -- null until rollback eligibility has
// been assessed (see InitializationRollbackStatus.NOT_ASSESSED).
enum InitializationRollbackEligibility {
  ELIGIBLE
  BLOCKED
}

enum InitializationRollbackStatus {
  NOT_ASSESSED
  ELIGIBLE
  BLOCKED
  ROLLED_BACK
  ROLLBACK_FAILED
}

enum InitializationApplyStatus {
  PENDING
  COMMITTED
  ROLLED_BACK_ATTEMPT_FAILED
}

// ---------------------------------------------------------------------------
// Core tables
// ---------------------------------------------------------------------------

model User {
  id           String  @id @default(uuid())
  // Branch Employee Authorization (CR-003 follow-up): nullable — `staff`
  // rows are Employees, authorized only inside an already-authenticated
  // `branch` session, and never have their own login credentials.
  // branch/supervisor/super_admin rows always have both.
  email        String? @unique
  passwordHash String? @map("password_hash")

  role           Role
  firstName      String         @map("first_name")
  lastName       String         @map("last_name")
  phone          String?
  employeeId     String?        @unique @map("employee_id")
  employmentType EmploymentType @map("employment_type")
  // Job title (e.g. "Cashier", "Shift Lead") — free text, not an enum.
  position       String?
  notes          String?

  // Application-layer AES-256-GCM ciphertext — see src/lib/encryption.ts.
  // Never returned in standard API responses.
  sssNumberEncrypted        String? @map("sss_number_encrypted")
  philhealthNumberEncrypted String? @map("philhealth_number_encrypted")
  tinNumberEncrypted        String? @map("tin_number_encrypted")
  pagibigNumberEncrypted    String? @map("pagibig_number_encrypted")

  // Step 11b Phase 1: TOTP 2FA enrollment. totpSecret is application-layer
  // AES-256-GCM ciphertext (src/lib/encryption.ts), same as the government ID
  // fields above. totpBackupCodes stores bcrypt hashes, never plaintext.
  totpSecret      String?   @map("totp_secret")
  totpEnabled     Boolean   @default(false) @map("totp_enabled")
  totpEnrolledAt  DateTime? @map("totp_enrolled_at")
  totpBackupCodes String[]  @default([]) @map("totp_backup_codes")

  isActive    Boolean        @default(true) @map("is_active")
  status      EmployeeStatus @default(active)
  lastLoginAt DateTime?      @map("last_login_at")

  // Account lockout (Architecture doc §5.3): locked after 5 consecutive
  // failed attempts, auto-unlocks after 30 minutes, or manual Super Admin
  // unlock (clears both fields).
  loginAttempts Int       @default(0) @map("login_attempts")
  lockedUntil   DateTime? @map("locked_until")

  // Phase 5 (Employee Management). must_change_password is forced true on
  // every admin-created or reactivated account and cleared only by a
  // successful POST /api/auth/change-password. Deactivation never deletes
  // the row (locked rule) — these three columns record who/when/why.
  mustChangePassword Boolean   @default(true) @map("must_change_password")
  deactivatedAt      DateTime? @map("deactivated_at")
  deactivatedBy      String?   @map("deactivated_by")
  deactivationReason String?   @map("deactivation_reason")

  branchAssignments                UserBranchAssignment[]
  shiftsAsCashier                  Shift[]                @relation("ShiftCashier")
  shiftsOpenedBy                   Shift[]                @relation("ShiftOpenedBy")
  shiftReviewsReviewed             ShiftReview[]          @relation("ShiftReviewReviewer")
  attendanceRecords                AttendanceRecord[]     @relation("AttendanceEmployee")
  correctedAttendanceRecords       AttendanceRecord[]     @relation("AttendanceCorrector")
  auditLogs                        AuditLog[]
  createdProducts                  Product[]
  cashierTransactions              Transaction[]
  voidedTransactions               Transaction[]          @relation("TransactionVoidedBy")
  refundedTransactions             Transaction[]          @relation("TransactionRefundedBy")
  paymentProofVerifiedTransactions Transaction[]          @relation("TransactionPaymentProofVerifiedBy")
  refreshTokens                    RefreshToken[]
  pinCredentials                   PinCredential[]
  holdOrders                       HoldOrder[]
  passwordResetTokens              PasswordResetToken[]

  expenses Expense[]

  // Step 12a (System Settings)
  systemSettingsUpdated             SystemSetting[]             @relation("SystemSettingUpdater")
  notificationPreference            NotificationPreference?
  branchReceiptConfigsUpdated       BranchReceiptConfig[]       @relation("BranchReceiptConfigUpdater")
  branchPaymentMethodConfigsUpdated BranchPaymentMethodConfig[] @relation("BranchPaymentMethodConfigUpdater")

  // CR-005
  createdProductVariants  ProductVariant[]   @relation("ProductVariantCreatedBy")
  approvedProductVariants ProductVariant[]   @relation("ProductVariantApprovedBy")
  productChangeLogs       ProductChangeLog[] @relation("ProductChangeLogChangedBy")

  // CR-009
  initiatedInitializationRuns InitializationRun[]

  // CR-008
  createdProductCategories          ProductCategory[]
  createdProductOptionGroups        ProductOptionGroup[]
  createdProductOptions             ProductOption[]
  createdProductVariantOptionGroups ProductVariantOptionGroup[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Branch {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique
  address         String
  city            String
  gpsLatitude     Decimal?     @map("gps_latitude") @db.Decimal(10, 8)
  gpsLongitude    Decimal?     @map("gps_longitude") @db.Decimal(11, 8)
  gpsRadiusMeters Int          @default(100) @map("gps_radius_meters")
  status          BranchStatus @default(active)
  gcashQrUrl      String?
  gcashQrKey      String?

  userAssignments     UserBranchAssignment[]
  productAvailability BranchProductAvailability[]
  flavorAvailability  BranchFlavorAvailability[]
  ingredients         Ingredient[]
  transactions        Transaction[]
  shifts              Shift[]
  holdOrders          HoldOrder[]
  inventoryMovements  InventoryMovement[]
  attendanceRecords   AttendanceRecord[]
  auditLogs           AuditLog[]
  fraudAlerts         FraudAlert[]

  // CR-006 Phase A
  inventoryStocks InventoryStock[]
  inventoryStockMovements InventoryStockMovement[]

  // CR-001
  exclusiveProducts Product[]          @relation("ProductExclusiveBranch")
  productInventory  ProductInventory[]

  expenses Expense[]

  // Step 12a (System Settings)
  receiptConfig       BranchReceiptConfig?
  paymentMethodConfig BranchPaymentMethodConfig?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

model UserBranchAssignment {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  branchId   String    @map("branch_id")
  assignedAt DateTime  @default(now()) @map("assigned_at")
  removedAt  DateTime? @map("removed_at")

  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([branchId])
  @@map("user_branch_assignments")
}

// ---------------------------------------------------------------------------
// Authentication
// ---------------------------------------------------------------------------

/// Opaque refresh tokens are never stored in plaintext — only a SHA-256 hash
/// of the token value. Rotated on every use (Architecture doc §5.1): using
/// a token sets its revokedAt and creates a new row; replacedBy links the
/// chain for audit purposes.
model RefreshToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  tokenHash  String    @unique @map("token_hash")
  deviceId   String    @map("device_id")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  replacedBy String?   @map("replaced_by")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([deviceId])
  @@index([userId, revokedAt])
  @@map("refresh_tokens")
}

/// Phase 21: Postgres replacement for the Redis access-token blacklist.
/// Populated by logout / logout-all-devices / password-change. Rows past
/// their own expiresAt are inert (verify-access-token.ts filters on it) —
/// left in place rather than actively swept, since a dead row is harmless
/// and this table is small (one row per revoked token, cleared by its own
/// natural access-token TTL).
model RevokedToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("revoked_tokens")
}

/// Phase 21: Postgres replacement for the Redis-backed password reset token.
/// One live token per request (requestPasswordReset overwrites any prior
/// token for the same value via upsert-by-hash); consumed (deleted) by
/// resetPassword or left to expire via expiresAt.
model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Restores the short-lived rotation result cache that Phase 20.5 (commit
/// 9507200) built on Redis and Phase 21 (commit 28a2956) dropped when Redis
/// was removed. withAdvisoryLock (see auth.repository.ts) only serializes
/// the check-then-rotate sequence — it does not make a second near-duplicate
/// request see the first request's result, so a losing caller was getting
/// REFRESH_INVALID on an already-rotated token instead of the rotated pair.
/// Keyed by the pre-rotation token's hash; read/pruned by createdAt age.
model RefreshTokenRotationCache {
  id                 String   @id @default(uuid())
  originalTokenHash  String   @unique @map("original_token_hash")
  cachedAccessToken  String   @map("cached_access_token")
  cachedRefreshToken String   @map("cached_refresh_token")
  cachedExpiresAt    DateTime @map("cached_expires_at")
  createdAt          DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("refresh_token_rotation_cache")
}

/// Phase 21: Postgres replacement for Redis INCR-based ID generation
/// (employee IDs, per-city branch codes). `key` is the counter's name
/// (e.g. "employee_id_counter", "branch_code_counter:QC"); nextCounterValue
/// (lib/id-counter.ts) increments it atomically via INSERT ... ON CONFLICT.
model IdCounter {
  key   String @id
  value Int    @default(0)

  @@map("id_counters")
}

/// One PIN per (user, device) pair. Only usable on a device that has already
/// completed full email/password authentication — enforced in the service
/// layer by requiring an active, non-revoked RefreshToken for the same
/// deviceId before a PIN can be set.
model PinCredential {
  id       String @id @default(uuid())
  userId   String @map("user_id")
  deviceId String @map("device_id")
  pinHash  String @map("pin_hash")

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, deviceId])
  @@map("pin_credentials")
}

// ---------------------------------------------------------------------------
// Product and flavor system
// ---------------------------------------------------------------------------

model Product {
  id                String        @id @default(uuid())
  name              String
  description       String?
  category          String?
  status            ProductStatus @default(draft)
  displayOrder      Int?          @map("display_order")
  isSeasonal        Boolean       @default(false) @map("is_seasonal")
  seasonalStartDate DateTime?     @map("seasonal_start_date") @db.Date
  seasonalEndDate   DateTime?     @map("seasonal_end_date") @db.Date
  createdBy         String?       @map("created_by")

  // CR-001: branch-exclusive products (created directly by Super Admin with
  // this flag, or via an approved product_requests row) skip the
  // all-active-branches cascade and are only ever available at one branch.
  branchExclusive   Boolean @default(false) @map("branch_exclusive")
  exclusiveBranchId String? @map("exclusive_branch_id")

  // CR-008: canonical ProductCategory FK, additive alongside the legacy free-text
  // `category` column above (left untouched — existing POS/reporting code still
  // reads it). New admin UI writes categoryId; `category` is no longer required.
  categoryId String? @map("category_id")

  creator            User?                       @relation(fields: [createdBy], references: [id])
  exclusiveBranch    Branch?                     @relation("ProductExclusiveBranch", fields: [exclusiveBranchId], references: [id])
  productCategory    ProductCategory?            @relation(fields: [categoryId], references: [id])
  variants           ProductVariant[]
  branchAvailability BranchProductAvailability[]
  transactionItems   TransactionItem[]
  holdOrderItems     HoldOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@index([categoryId])
  @@map("products")
}

model ProductVariant {
  id               String   @id @default(uuid())
  productId        String   @map("product_id")
  name             String
  sizeLabel        String   @map("size_label")
  basePrice        Decimal  @map("base_price") @db.Decimal(10, 2)
  // For Tera Mix products, caps VATable portion to Mega Mix SRP. NULL = full SRP is VATable.
  vatableCapAmount Decimal? @map("vatable_cap_amount") @db.Decimal(10, 2)
  displayOrder     Int?     @map("display_order")
  isActive         Boolean  @default(true) @map("is_active")

  // Phase 21: kcal is the variant's base calorie count (before flavor
  // kcalOffset); maxFlavors caps how many flavors a customer may pick for
  // this size (e.g. Mega/Giga fries = 2, Tera = 3, everything else = 1).
  kcal       Int? @map("kcal")
  maxFlavors Int  @default(1) @map("max_flavors")

  // CR-005 Phase 1: variant-level approval lifecycle, distinct from the
  // existing Product.status (ProductStatus) — grandfathered rows default to
  // ACTIVE. version/lastChangeReason back the change-log audit trail;
  // createdBy/approvedBy record the Product Builder approval workflow.
  lifecycleStatus  VariantLifecycleStatus @default(ACTIVE) @map("lifecycle_status")
  version          Int                    @default(1)
  lastChangeReason String?                @map("last_change_reason")
  createdById      String?                @map("created_by_id")
  approvedById     String?                @map("approved_by_id")
  approvedAt       DateTime?              @map("approved_at")

  product          Product                @relation(fields: [productId], references: [id])
  createdBy        User?                  @relation("ProductVariantCreatedBy", fields: [createdById], references: [id])
  approvedBy       User?                  @relation("ProductVariantApprovedBy", fields: [approvedById], references: [id])
  variantFlavors   ProductVariantFlavor[]
  transactionItems TransactionItem[]
  holdOrderItems   HoldOrderItem[]
  flavorSlots      ProductFlavorSlot[]
  changeLogs       ProductChangeLog[]
  productInventory ProductInventory[]

  // Mix & Max — slots this variant is a sellable snack option for.
  snackSlotOptions ProductFlavorSlotSnackOption[] @relation("SnackOptionVariant")

  // CR-006 Phase A
  productComponents ProductComponent[]

  // CR-008: generic Option Group assignments (Flavor/Size/Add-ons/etc.),
  // distinct from the legacy variantFlavors above.
  optionGroupAssignments ProductVariantOptionGroup[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([productId])
  @@index([lifecycleStatus])
  @@index([createdById])
  @@index([approvedById])
  @@map("product_variants")
}

model Flavor {
  id           String  @id @default(uuid())
  name         String
  description  String?
  colorHex     String? @map("color_hex")
  displayOrder Int?    @map("display_order")
  isActive     Boolean @default(true) @map("is_active")

  // Phase 21: catalog-level defaults. isPremium flags upsell flavors (e.g.
  // Sweet Corn); addOnPrice is the default add-on charge seeded into each
  // ProductVariantFlavor.pricePremium at variant-assignment time — the
  // per-variant pricePremium remains the source of truth actually read at
  // checkout, this is just the catalog default so a new size doesn't need
  // its premium re-entered by hand.
  isPremium  Boolean @default(false) @map("is_premium")
  addOnPrice Decimal @default(0) @map("add_on_price") @db.Decimal(10, 2)
  kcalOffset Int     @default(0) @map("kcal_offset")

  // CR-005 Phase 1 (Fix 2): flavor->ingredient linkage by name+unit, resolved
  // against the selling branch's Ingredient row via the CR-004 resolver.
  // Nullable — backfilled in a later phase.
  ingredientName String @map("ingredient_name")
  ingredientUnit String @map("ingredient_unit")

  variantFlavors     ProductVariantFlavor[]
  branchAvailability BranchFlavorAvailability[]
  transactionItems   TransactionItem[]
  holdOrderItems     HoldOrderItem[]
  productInventory   ProductInventory[]
  productComponents  ProductComponent[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("flavors")
}

model ProductVariantFlavor {
  id               String  @id @default(uuid())
  productVariantId String  @map("product_variant_id")
  flavorId         String  @map("flavor_id")
  pricePremium     Decimal @default(0) @map("price_premium") @db.Decimal(10, 2)
  isAvailable      Boolean @default(true) @map("is_available")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  flavor         Flavor         @relation(fields: [flavorId], references: [id])

  @@unique([productVariantId, flavorId])
  @@map("product_variant_flavors")
}

model BranchProductAvailability {
  id          String  @id @default(uuid())
  branchId    String  @map("branch_id")
  productId   String  @map("product_id")
  isAvailable Boolean @default(true) @map("is_available")
  updatedBy   String? @map("updated_by")

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, productId])
  @@map("branch_product_availability")
}

model BranchFlavorAvailability {
  id                String  @id @default(uuid())
  branchId          String  @map("branch_id")
  flavorId          String  @map("flavor_id")
  isAvailable       Boolean @default(true) @map("is_available")
  unavailableReason String? @map("unavailable_reason")

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  flavor Flavor @relation(fields: [flavorId], references: [id])

  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, flavorId])
  @@map("branch_flavor_availability")
}

// ---------------------------------------------------------------------------
// CR-008 — Universal Product Catalog. Admin-owned identity: categories, and a
// generic Option Group/Option architecture that replaces standalone-Flavor
// creation for new product work (legacy Flavor/ProductVariantFlavor above are
// preserved unchanged — see docs/decisions/CR-008-universal-product-catalog.md).
// ---------------------------------------------------------------------------

model ProductCategory {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int?    @map("sort_order")
  createdBy   String? @map("created_by")

  creator  User?     @relation(fields: [createdBy], references: [id])
  products Product[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("product_categories")
}

model ProductOptionGroup {
  id             String                     @id @default(uuid())
  code           String                     @unique
  name           String
  description    String?
  posButtonLabel String?                    @map("pos_button_label")
  selectionType  ProductOptionSelectionType @map("selection_type")
  minSelections  Int                        @default(0) @map("min_selections")
  maxSelections  Int?                       @map("max_selections")
  required       Boolean                    @default(false)
  isActive       Boolean                    @default(true) @map("is_active")
  sortOrder      Int?                       @map("sort_order")
  createdBy      String?                    @map("created_by")

  creator            User?                       @relation(fields: [createdBy], references: [id])
  options            ProductOption[]
  variantAssignments ProductVariantOptionGroup[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive])
  @@map("product_option_groups")
}

model ProductOption {
  id              String  @id @default(uuid())
  optionGroupId   String  @map("option_group_id")
  code            String
  name            String
  priceAdjustment Decimal @default(0) @map("price_adjustment") @db.Decimal(10, 2)
  imageUrl        String? @map("image_url")
  isActive        Boolean @default(true) @map("is_active")
  sortOrder       Int?    @map("sort_order")
  createdBy       String? @map("created_by")

  optionGroup           ProductOptionGroup                @relation(fields: [optionGroupId], references: [id])
  creator               User?                             @relation(fields: [createdBy], references: [id])
  variantAllowedOptions ProductVariantOptionGroupOption[]
  components            ProductComponent[]
  inventoryMapping      ProductOptionInventoryMapping?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([optionGroupId, code])
  @@map("product_options")
}

/// Assigns an Option Group to a Product Variant (R6). required overrides the
/// group's own `required` default when set; sortOrder controls rendering
/// order among a variant's assigned groups.
model ProductVariantOptionGroup {
  id               String   @id @default(uuid())
  productVariantId String   @map("product_variant_id")
  optionGroupId    String   @map("option_group_id")
  required         Boolean? @map("required")
  sortOrder        Int?     @map("sort_order")
  createdBy        String?  @map("created_by")

  productVariant ProductVariant                    @relation(fields: [productVariantId], references: [id])
  optionGroup    ProductOptionGroup                @relation(fields: [optionGroupId], references: [id])
  creator        User?                             @relation(fields: [createdBy], references: [id])
  allowedOptions ProductVariantOptionGroupOption[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productVariantId, optionGroupId])
  @@map("product_variant_option_groups")
}

/// The subset of an assigned group's options actually sellable on this
/// variant (R6 "control allowed options"), with independent ordering.
model ProductVariantOptionGroupOption {
  id                   String @id @default(uuid())
  variantOptionGroupId String @map("variant_option_group_id")
  productOptionId      String @map("product_option_id")
  sortOrder            Int?   @map("sort_order")

  variantOptionGroup ProductVariantOptionGroup @relation(fields: [variantOptionGroupId], references: [id], onDelete: Cascade)
  productOption      ProductOption             @relation(fields: [productOptionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([variantOptionGroupId, productOptionId])
  @@map("product_variant_option_group_options")
}

// ---------------------------------------------------------------------------
// CR-001 — branch approval workflows (product requests, price overrides)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Inventory and recipes
// ---------------------------------------------------------------------------

/// currentStock is a Phase-0-scaffolded stored field, superseded by Phase 8:
/// current stock is always derived by replaying InventoryMovement rows for
/// the ingredient (see inventoryRepository.getCurrentStock), never read or
/// written directly outside ingredient creation's initial snapshot. Kept in
/// the schema rather than dropped to avoid an unrelated destructive column
/// migration in the same step that introduces the derivation.
model Ingredient {
  id                String             @id @default(uuid())
  name              String
  unit              String
  currentStock      Decimal            @default(0) @map("current_stock") @db.Decimal(10, 3)
  lowStockThreshold Decimal            @map("low_stock_threshold") @db.Decimal(10, 3)
  criticalThreshold Decimal            @map("critical_threshold") @db.Decimal(10, 3)
  unitCost          Decimal?           @map("unit_cost") @db.Decimal(10, 4)
  branchId          String             @map("branch_id")
  deletedAt         DateTime?          @map("deleted_at")
  // CR-005 Phase 1
  category          IngredientCategory @default(OTHER)

  branch           Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  movements        InventoryMovement[]
  productInventory ProductInventory[]

  // CR-006 Phase A — populated by the Phase C backfill; nullable until then.
  identityMapping InventoryIdentityMapping?

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId])
  // Unique on (branch_id, name) WHERE deleted_at IS NULL — a soft-deleted
  // ingredient's name can be reused. Partial index added by raw SQL in the
  // migration — Prisma's schema DSL has no WHERE-clause index syntax.
  @@map("ingredients")
}

/// The flavorId column is the key field for the deduction algorithm:
/// ProductInventory is the inventory deduction source of truth — generic,
/// branch-agnostic mapping of which Ingredient rows (and how much of each)
/// a ProductVariant requires. Mappings may include base variant ingredient
/// mappings (flavorId IS NULL) and optional flavor-specific ingredient
/// mappings (flavorId set), keyed by variant + ingredient (+ flavor).
model ProductInventory {
  id               String  @id @default(uuid())
  branchId         String  @map("branch_id")
  productVariantId String  @map("product_variant_id")
  ingredientId     String  @map("ingredient_id")
  flavorId         String? @map("flavor_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(10, 4)
  unit             String
  /// Bumped on every ProductInventory update; source for TransactionItem.recipeVersion once transactions.service.ts is switched over.
  version          Int     @default(1)

  // Soft-delete + audit metadata. deletedAt/isActive follow the same
  // soft-delete shape as Ingredient/Recipe/BranchRecipeOverride; reason
  // records why a mapping was deactivated, createdBy/updatedBy record who
  // last touched the row (no FK — same pattern as BranchRecipeOverride
  // avoids coupling this table to User lifecycle).
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")
  reason    String?
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  branch         Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  ingredient     Ingredient     @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  flavor         Flavor?        @relation(fields: [flavorId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // No @@unique here: active-row uniqueness on (branch_id, product_variant_id,
  // ingredient_id, flavor_id) is enforced by a partial unique index
  // (WHERE deleted_at IS NULL) created via raw SQL in the migration, since
  // Prisma's schema DSL cannot express a partial index. See migration
  // add_product_inventory_soft_delete.
  @@index([branchId])
  @@index([productVariantId])
  @@index([ingredientId])
  @@index([flavorId])
  @@map("product_inventory")
}

/// CR-005 Phase 1 — Product Builder flavor-slot definition for a variant
/// (e.g. "Flavor 1", "Flavor 2" on a Mega/Giga size). Distinct from the
/// existing ProductVariantFlavor (which flavors are assignable/priced for a
/// variant) — this defines the slot structure itself that flavor picks fill.
model ProductFlavorSlot {
  id               String   @id @default(cuid())
  productVariantId String   @map("product_variant_id")
  slotIndex        Int      @map("slot_index")
  label            String
  flavorQty        Decimal  @map("flavor_qty") @db.Decimal(10, 3)
  unit             String
  required         Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)
  snackOptions   ProductFlavorSlotSnackOption[]

  @@unique([productVariantId, slotIndex])
  @@index([productVariantId])
  @@map("product_flavor_slots")
}

/// Mix & Max — which snack ProductVariants (e.g. Fries, Loopys) are sellable
/// into a given ProductFlavorSlot. The selected snackProductVariantId is what
/// inventory deduction resolves ProductInventory against, not the parent
/// Mix & Max variant — see product-inventory.service.ts computeDeductionForSlots.
model ProductFlavorSlotSnackOption {
  id                   String   @id @default(cuid())
  flavorSlotId         String   @map("flavor_slot_id")
  snackProductVariantId String  @map("snack_product_variant_id")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  flavorSlot         ProductFlavorSlot @relation(fields: [flavorSlotId], references: [id], onDelete: Cascade)
  snackProductVariant ProductVariant   @relation("SnackOptionVariant", fields: [snackProductVariantId], references: [id], onDelete: Cascade)

  @@unique([flavorSlotId, snackProductVariantId])
  @@index([flavorSlotId])
  @@index([snackProductVariantId])
  @@map("product_flavor_slot_snack_options")
}

/// CR-005 Phase 1 — append-only audit trail of ProductVariant changes.
/// snapshotJson freezes the full variant state at the time of the change,
/// same snapshot rationale as TransactionItem's name/price fields.
model ProductChangeLog {
  id               String   @id @default(cuid())
  productVariantId String   @map("product_variant_id")
  version          Int
  changedById      String   @map("changed_by_id")
  reason           String
  snapshotJson     Json     @map("snapshot_json")
  createdAt        DateTime @default(now()) @map("created_at")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  changedBy      User           @relation("ProductChangeLogChangedBy", fields: [changedById], references: [id])

  @@index([productVariantId, version])
  @@index([createdAt])
  @@map("product_change_logs")
}

/// Append-only. No row is ever updated or deleted — the full history of
/// every ingredient's stock level is recoverable by replaying movements.
model InventoryMovement {
  id             String          @id @default(uuid())
  branchId       String          @map("branch_id")
  ingredientId   String          @map("ingredient_id")
  movementType   MovementType    @map("movement_type")
  quantityChange Decimal         @map("quantity_change") @db.Decimal(10, 3)
  quantityBefore Decimal         @map("quantity_before") @db.Decimal(10, 3)
  quantityAfter  Decimal         @map("quantity_after") @db.Decimal(10, 3)
  referenceId    String?         @map("reference_id")
  notes          String?
  imageProofUrl  String?         @map("image_proof_url")
  imageProofType ImageProofType? @map("image_proof_type")
  approvedBy     String?         @map("approved_by")
  recordedBy     String?         @map("recorded_by")

  branch     Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")

  projectionOutbox InventoryProjectionOutbox?

  @@index([branchId])
  @@index([ingredientId])
  @@map("inventory_movements")
}

enum InventoryProjectionOutboxStatus {
  pending
  processing
  deferred
  processed
  stuck
}

/// Durable outbox for projecting InventoryMovement into future read-optimized
/// stock tables (CR-010A). InventoryMovement remains the source of truth —
/// this table only tracks which movements still need to be projected, so a
/// worker can poll/retry safely. One row per movement; movementId is the
/// projection idempotency key, enforced by the unique constraint below.
model InventoryProjectionOutbox {
  id            String                           @id @default(uuid())
  movementId    String                           @unique @map("movement_id")
  status        InventoryProjectionOutboxStatus  @default(pending)
  attempts      Int                              @default(0)
  lastError     String?                          @map("last_error")
  nextAttemptAt DateTime?                        @map("next_attempt_at")
  lockedAt      DateTime?                        @map("locked_at")
  claimToken    String?                          @map("claim_token")
  processedAt   DateTime?                        @map("processed_at")
  createdAt     DateTime                         @default(now()) @map("created_at")
  updatedAt     DateTime                         @updatedAt @map("updated_at")

  movement InventoryMovement @relation(fields: [movementId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([nextAttemptAt])
  @@index([createdAt])
  @@map("inventory_projection_outbox")
}

// ---------------------------------------------------------------------------
// CR-006 Phase A — Universal Inventory Domain foundation (CR-007).
// Purely additive: coexists with Ingredient/ProductInventory/InventoryMovement
// above until later phases backfill and cut over. Nothing here is read or
// written by runtime code yet.
// ---------------------------------------------------------------------------

/// CR-006 Phase A corrective — InventoryCategory is a data-managed lookup
/// table, not a hardcoded enum: categories are operator-configurable, not a
/// fixed food-specific taxonomy baked into the schema.
model InventoryCategory {
  id          String  @id @default(uuid())
  name        String
  code        String?
  description String?
  isActive    Boolean @default(true) @map("is_active")

  items InventoryItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("inventory_categories")
}

/// Lookup table of measurement units. Dimension-only classification --
/// conversion between units (even within the same dimension) is never a
/// single universal factor stored here (e.g. sack-of-rice vs sack-of-flour),
/// so it is not a schema field. Genuinely global same-dimension conversions
/// (kg<->g, L<->mL) live in UnitConversion; item/packaging-specific
/// conversions are out of scope for Phase A.
model UnitOfMeasure {
  id         String        @id @default(uuid())
  code       String        @unique
  name       String
  dimension  UnitDimension
  isBaseUnit Boolean       @default(false) @map("is_base_unit")
  isActive   Boolean       @default(true) @map("is_active")

  items             InventoryItem[]
  conversionsFrom   UnitConversion[]         @relation("UnitConversionFrom")
  conversionsTo     UnitConversion[]         @relation("UnitConversionTo")
  recipeComponents  ProductComponent[]
  stockMovements    InventoryStockMovement[]
  optionDeductionMappings ProductOptionInventoryMapping[]
  itemConversionsFrom InventoryItemUnitConversion[] @relation("InventoryItemUnitConversionFrom")
  itemConversionsTo   InventoryItemUnitConversion[] @relation("InventoryItemUnitConversionTo")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("units_of_measure")
}

/// Genuinely global, dimension-compatible unit conversions (kilogram<->gram,
/// liter<->milliliter). Does NOT model variable packaging conversions (sack,
/// box, tray, case, pack) -- those have no universal factor and belong on a
/// future item-specific or purchasing-entry attach point, not here.
model UnitConversion {
  id         String  @id @default(uuid())
  fromUnitId String  @map("from_unit_id")
  toUnitId   String  @map("to_unit_id")
  factor     Decimal @db.Decimal(18, 8)

  fromUnit UnitOfMeasure @relation("UnitConversionFrom", fields: [fromUnitId], references: [id])
  toUnit   UnitOfMeasure @relation("UnitConversionTo", fields: [toUnitId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([fromUnitId, toUnitId])
  @@map("unit_conversions")
}

/// TASK 115 — per-InventoryItem override of UnitConversion. UnitConversion's
/// factor is global across every item sharing a unit pair, which is wrong
/// for ingredients that differ by density (e.g. Cheese Flavor Powder: 1 tbsp
/// = 7g vs BBQ Flavor Powder: 1 tbsp = 6g). A row here takes precedence over
/// the matching UnitConversion row for the same unit pair; UnitConversion
/// remains the fallback when no item-specific row exists (see
/// unit-conversion.util.ts's resolution order).
model InventoryItemUnitConversion {
  id              String  @id @default(uuid())
  inventoryItemId String  @map("inventory_item_id")
  fromUnitId      String  @map("from_unit_id")
  toUnitId        String  @map("to_unit_id")
  factor          Decimal @db.Decimal(18, 8)

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  fromUnit      UnitOfMeasure @relation("InventoryItemUnitConversionFrom", fields: [fromUnitId], references: [id], onDelete: Restrict)
  toUnit        UnitOfMeasure @relation("InventoryItemUnitConversionTo", fields: [toUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([inventoryItemId, fromUnitId, toUnitId])
  @@index([inventoryItemId])
  @@index([fromUnitId])
  @@index([toUnitId])
  @@map("inventory_item_unit_conversions")
}

/// CR-007 §3 — the only immutable identity in the inventory domain. Replaces
/// Ingredient's identity role. branchId is intentionally absent: InventoryItem
/// is branch-agnostic; InventoryStock carries the per-branch aggregate
/// (§13.3). sku/barcode are nullable, mutable, case-insensitively-unique
/// business identifiers, never a join key (§3.1-3.2) -- uniqueness enforced
/// by partial case-insensitive indexes added via raw SQL in the migration
/// (Prisma's DSL cannot express citext/lower() collation).
model InventoryItem {
  id             String    @id @default(uuid())
  name           String
  sku            String?
  barcode        String?
  categoryId     String?   @map("category_id")
  baseUnitId     String    @map("base_unit_id")
  trackInventory Boolean   @default(true) @map("track_inventory")
  // Default per-unit cost used for valuation when no branch-specific
  // InventoryStock.unitCost override exists (CR-007 §20 valuation cutover).
  unitCost       Decimal?  @map("unit_cost") @db.Decimal(10, 4)
  deletedAt      DateTime? @map("deleted_at")

  category          InventoryCategory?         @relation(fields: [categoryId], references: [id])
  baseUnit          UnitOfMeasure              @relation(fields: [baseUnitId], references: [id])
  stocks            InventoryStock[]
  stockMovements    InventoryStockMovement[]
  productComponents ProductComponent[]
  identityMappings  InventoryIdentityMapping[]
  optionMappings    ProductOptionInventoryMapping[]
  unitConversions   InventoryItemUnitConversion[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([categoryId])
  @@index([baseUnitId])
  @@map("inventory_items")
}

/// CR-007 §20.2 -- owns all legacy Ingredient -> InventoryItem migration
/// metadata so InventoryItem itself stays clean of migration-era fields.
/// Populated by the Phase C backfill, not Phase A. inventoryItemId stays
/// nullable until a mapping is resolved -- PENDING/AMBIGUOUS/REJECTED rows
/// have no candidate (or no accepted candidate) yet.
model InventoryIdentityMapping {
  id                 String                  @id @default(uuid())
  inventoryItemId    String?                 @map("inventory_item_id")
  legacyIngredientId String                  @map("legacy_ingredient_id")
  legacyName         String                  @map("legacy_name")
  legacyUnit         String                  @map("legacy_unit")
  mappingStatus      InventoryMappingStatus  @default(PENDING) @map("mapping_status")
  mappingMethod      InventoryMappingMethod? @map("mapping_method")
  reviewedBy         String?                 @map("reviewed_by")
  reviewedAt         DateTime?               @map("reviewed_at")
  notes              String?
  migrationBatch     String?                 @map("migration_batch")
  migratedAt         DateTime?               @map("migrated_at")

  inventoryItem    InventoryItem? @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  legacyIngredient Ingredient     @relation(fields: [legacyIngredientId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([legacyIngredientId])
  @@index([inventoryItemId])
  @@map("inventory_identity_mappings")
}

/// CR-007 §13.3 -- per-branch aggregate projection over InventoryItem, one
/// row per (branchId, inventoryItemId). A projection, never the source of
/// truth: updated transactionally with its owning InventoryMovement starting
/// Phase G, never hand-edited outside a declared reconciliation path (Phase
/// H). Empty/zero-row in Phase A -- nothing populates it yet. Low/critical
/// thresholds live here (not on InventoryItem) since they may differ by
/// branch. version is an optimistic-concurrency guard for detecting stale
/// projection writes -- Phase G may additionally use advisory locking.
model InventoryStock {
  id                String   @id @default(uuid())
  branchId          String   @map("branch_id")
  inventoryItemId   String   @map("inventory_item_id")
  quantityOnHand    Decimal  @default(0) @map("quantity_on_hand") @db.Decimal(10, 3)
  lowStockThreshold Decimal? @map("low_stock_threshold") @db.Decimal(10, 3)
  criticalThreshold Decimal? @map("critical_threshold") @db.Decimal(10, 3)
  // Branch-specific override of InventoryItem.unitCost for valuation (e.g. a
  // branch paying a different supplier price). Null means "use the item's
  // default cost" -- not "cost is zero".
  unitCost          Decimal? @map("unit_cost") @db.Decimal(10, 4)
  version           Int      @default(0)
  /// CR-010A.3 -- watermark set by the reconciliation rebuild: the latest
  /// InventoryMovement.createdAt already folded into quantityOnHand as of
  /// the last rebuild. The projection worker (applyProjection) compares an
  /// outbox row's movement.createdAt against this before incrementing --
  /// a movement at or before the watermark is already reflected in the
  /// rebuilt quantity, so applying it again would double-count. Null means
  /// this row has never been rebuilt; normal incremental projection is
  /// unaffected either way.
  rebuiltThroughAt  DateTime? @map("rebuilt_through_at")

  branch        Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([branchId, inventoryItemId])
  @@index([inventoryItemId])
  @@map("inventory_stocks")
}

enum InventoryStockMovementType {
  RECEIVING
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  WASTE
  TRANSFER_IN
  TRANSFER_OUT
  PHYSICAL_COUNT
  SALE
  SALE_REVERSAL
}

/// Branch inventory cutover -- append-only ledger for every InventoryStock
/// quantity change. Written in the same database transaction as the
/// InventoryStock.quantityOnHand update it explains (never after the fact).
/// Mirrors the legacy InventoryMovement's role but keyed on InventoryItem
/// instead of Ingredient, and is additive to it -- InventoryMovement keeps
/// recording legacy-path changes untouched. referenceType/referenceId are a
/// loose polymorphic pointer (e.g. "transaction" / transactionId for
/// SALE/SALE_REVERSAL, "transfer" / a shared transfer id linking the paired
/// TRANSFER_OUT/TRANSFER_IN rows) -- no FK, since the referenced entity type
/// varies by movementType.
model InventoryStockMovement {
  id                 String                     @id @default(uuid())
  branchId           String                     @map("branch_id")
  inventoryItemId    String                     @map("inventory_item_id")
  movementType       InventoryStockMovementType @map("movement_type")
  quantityChange     Decimal                    @map("quantity_change") @db.Decimal(10, 3)
  quantityBefore     Decimal                    @map("quantity_before") @db.Decimal(10, 3)
  quantityAfter      Decimal                    @map("quantity_after") @db.Decimal(10, 3)
  unitId             String?                    @map("unit_id")
  referenceType      String?                    @map("reference_type")
  referenceId        String?                    @map("reference_id")
  notes              String?
  performedByUserId  String?                    @map("performed_by_user_id")

  branch        Branch         @relation(fields: [branchId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  unit          UnitOfMeasure? @relation(fields: [unitId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@index([branchId, inventoryItemId])
  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_stock_movements")
}

/// CR-007 §10 -- join between a ProductVariant and the InventoryItem it
/// consumes. Supersedes ProductInventory. Neutral: no reference to Flavor,
/// ProductFlavorSlot, or any product-option construct -- flavor-specific
/// deduction remains on the existing compatibility architecture
/// (ProductInventory.flavorId) until a future option-component CR is
/// approved. A ProductVariant may have zero ProductComponent rows -- a valid
/// first-class state for non-stock products/services (§9.1), not an error.
model ProductComponent {
  id               String  @id @default(uuid())
  productVariantId String  @map("product_variant_id")
  inventoryItemId  String  @map("inventory_item_id")
  // Quantity expressed in recipeUnitId's unit (the recipe-authoring unit),
  // not necessarily the InventoryItem's base unit -- conversion to base
  // unit happens only where deduction actually needs it (see
  // shadow-bom-deduction.service.ts / unit-conversion.util.ts).
  quantityRequired Decimal @map("quantity_required") @db.Decimal(18, 6)
  // Nullable for backfill safety -- rows created before this column existed
  // (and the legacy backfill, which always writes base-unit quantities) may
  // have no recipeUnitId; consumers treat null as "already the item's base
  // unit". API-created rows always have this set (defaulted to the item's
  // base unit when omitted) and are validated at the service layer to share
  // the item's base unit UnitDimension.
  recipeUnitId String? @map("recipe_unit_id")
  version      Int     @default(1)

  // Nullable: NULL means this component applies regardless of flavor
  // (packaging, base powder, etc). Set means it only applies when this
  // specific flavor is selected -- e.g. the flavor-specific seasoning that
  // legacy modeled via Flavor.ingredientName/ingredientUnit instead.
  flavorId String? @map("flavor_id")

  // Nullable: NULL means this component is a base component, not dependent
  // on a Product Option. Set means it only deducts when that Product Option
  // is selected -- same nullable-scope pattern as flavorId above.
  productOptionId String? @map("product_option_id")

  // Soft-delete + audit metadata, matching ProductInventory's shape.
  deletedAt DateTime? @map("deleted_at")
  isActive  Boolean   @default(true) @map("is_active")
  reason    String?
  createdBy String?   @map("created_by")
  updatedBy String?   @map("updated_by")

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  recipeUnit     UnitOfMeasure? @relation(fields: [recipeUnitId], references: [id])
  flavor         Flavor?        @relation(fields: [flavorId], references: [id], onDelete: Cascade)
  productOption  ProductOption? @relation(fields: [productOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // No @@unique here: active-row uniqueness on (product_variant_id,
  // inventory_item_id) is enforced by a partial unique index (WHERE
  // deleted_at IS NULL) created via raw SQL in the migration, since
  // Prisma's schema DSL cannot express a partial index -- same pattern as
  // ProductInventory. See migration cr011a_product_component_bom_foundation.
  @@index([productVariantId])
  @@index([inventoryItemId])
  @@index([recipeUnitId])
  @@index([productOptionId])
  @@map("product_components")
}

/// TASK 74 -- dedicated inventory deduction owned directly by ProductOption,
/// global across products/variants (unlike ProductComponent, which is scoped
/// to a ProductVariant). A ProductOption has zero or one mapping (enforced by
/// the unique productOptionId below). Category/base unit are intentionally
/// not stored here -- derive them from InventoryItem. inventoryItem and
/// deductionUnit use onDelete: Restrict (matching TransactionLine.product's
/// pattern) so a referenced InventoryItem/UnitOfMeasure can't be deleted out
/// from under a live mapping; productOption uses onDelete: Cascade since the
/// mapping has no meaning once its owning option is gone.
model ProductOptionInventoryMapping {
  id               String  @id @default(uuid())
  productOptionId  String  @unique @map("product_option_id")
  inventoryItemId  String  @map("inventory_item_id")
  quantityRequired Decimal @map("quantity_required") @db.Decimal(18, 6)
  deductionUnitId  String  @map("deduction_unit_id")

  productOption ProductOption @relation(fields: [productOptionId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  deductionUnit UnitOfMeasure @relation(fields: [deductionUnitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([inventoryItemId])
  @@index([deductionUnitId])
  @@map("product_option_inventory_mappings")
}

/// CR-012.1 -- shadow-mode classification of how a single sale line's BOM
/// (ProductComponent) deduction would have compared against the legacy
/// (ProductInventory) deduction that actually ran. See ShadowBomComparison.
enum ShadowBomComparisonClassification {
  MATCH
  BOM_NOT_READY
  MISSING_LEGACY_MAPPING
  MISSING_BOM_COMPONENT
  EXTRA_BOM_COMPONENT
  QUANTITY_MISMATCH
  UNIT_CONVERSION_UNSUPPORTED
  FLAVOR_DEPENDENCY
  ERROR
}

/// CR-012.1 -- Shadow BOM Deduction Calculation. Append-only, read-only
/// comparison record: for every eligible completed sale line, what the new
/// ProductComponent/BOM deduction would have been versus what the legacy
/// ProductInventory deduction actually was. Never read by any POS/reporting
/// runtime path and never itself writes InventoryMovement/InventoryStock/
/// ProductInventory -- see shadow-bom-deduction.service.ts. transactionId/
/// saleLineId are plain (unenforced) references, not Prisma relations --
/// this table must never gate or cascade against Transaction/TransactionItem
/// lifecycle (void/refund must be free to proceed regardless of this row's
/// state).
model ShadowBomComparison {
  id                String                            @id @default(uuid())
  transactionId     String                            @map("transaction_id")
  saleLineId        String                            @map("sale_line_id")
  branchId          String                            @map("branch_id")
  productVariantId  String                            @map("product_variant_id")
  // Normalized legacy deduction lines: Array<{ inventoryItemId: string | null,
  // legacyIngredientId: string, baseUnitId: string | null, quantity: number }>.
  legacyCalculation Json                              @map("legacy_calculation")
  // Normalized BOM deduction lines: Array<{ inventoryItemId: string,
  // baseUnitId: string, quantity: number }>. Null when classification is
  // BOM_NOT_READY (readiness blocked before a BOM calculation ran) or ERROR
  // (something threw before a BOM result existed).
  bomCalculation    Json?                             @map("bom_calculation")
  classification    ShadowBomComparisonClassification
  // Populated only when classification = ERROR: { message, stack } (message
  // truncated, no raw error object persisted -- same sanitization posture as
  // InventoryProjectionOutbox.lastError).
  errorDetails      Json?                             @map("error_details")
  comparedAt        DateTime                          @default(now()) @map("compared_at")

  // No @@unique([transactionId, saleLineId]) attribute here -- Prisma's
  // schema DSL @@unique already supports this (unlike the partial-index
  // cases elsewhere in this file), so it's declared normally and enforced
  // by a real unique index, used by the repository's idempotent upsert.
  @@unique([transactionId, saleLineId])
  @@index([classification])
  @@index([branchId])
  @@index([productVariantId])
  @@index([comparedAt])
  @@map("shadow_bom_comparisons")
}

// ---------------------------------------------------------------------------
// Transactions, shifts, cash
// ---------------------------------------------------------------------------

model Transaction {
  id                          String                   @id @default(uuid())
  transactionNumber           String                   @unique @map("transaction_number")
  branchId                    String                   @map("branch_id")
  shiftId                     String?                  @map("shift_id")
  cashierId                   String                   @map("cashier_id")
  status                      TransactionStatus        @default(completed)
  paymentMethod               PaymentMethod            @map("payment_method")
  subtotal                    Decimal                  @db.Decimal(10, 2)
  discountAmount              Decimal                  @default(0) @map("discount_amount") @db.Decimal(10, 2)
  vatAmount                   Decimal                  @map("vat_amount") @db.Decimal(10, 2)
  // Portion of the subtotal that was never vatable to begin with (line items
  // with a per-unit vatableCapAmount, once the cap is exceeded) — see
  // transactions.service.ts computeAmounts(). Independent of discount type:
  // PWD/Senior Citizen sales zero out vatAmount entirely instead (RA 9994 /
  // RA 10754 true VAT-exempt rule, locked in .claude/CLAUDE.md).
  vatExemptAmount             Decimal                  @default(0) @map("vat_exempt_amount") @db.Decimal(10, 2)
  totalAmount                 Decimal                  @map("total_amount") @db.Decimal(10, 2)
  amountTendered              Decimal?                 @map("amount_tendered") @db.Decimal(10, 2)
  changeAmount                Decimal?                 @map("change_amount") @db.Decimal(10, 2)
  gcashReference              String?                  @map("gcash_reference")
  gcashManuallyVerified       Boolean?                 @map("gcash_manually_verified")
  // Non-cash payment-proof capture (GCash/Maya/other) — mandatory for any
  // paymentMethod != cash, enforced server-side in transactions.service.ts.
  // Null for cash sales (not required) and for legacy rows predating this
  // feature. Storage KEY only, never a public/signed URL — mirrors
  // Expense.receiptKey, resolved to a fresh signed URL only on read.
  paymentProofKey             String?                  @map("payment_proof_key")
  paymentProofType            ImageProofType?          @map("payment_proof_type")
  paymentProofUploadedAt      DateTime?                @map("payment_proof_uploaded_at")
  // Reserved for a future admin "Mark Verified" action — not built in this
  // change, but the columns ship now to avoid a second migration later.
  paymentProofVerifiedAt      DateTime?                @map("payment_proof_verified_at")
  paymentProofVerifiedById    String?                  @map("payment_proof_verified_by_id")
  discountType                String?                  @map("discount_type")
  discountCustomerIdEncrypted String?                  @map("discount_customer_id_encrypted")
  // Deterministic HMAC-SHA256 of the same plaintext ID stored above —
  // discountCustomerIdEncrypted uses a random IV per encryption (see
  // lib/encryption.ts), so it can never be grouped/compared for equality.
  // This column exists solely so the Phase 17 discount-ID-reuse rule can
  // find repeated IDs; it is never decrypted and never returned in any API
  // response.
  discountCustomerIdHash      String?                  @map("discount_customer_id_hash")
  inventoryDeductionStatus    InventoryDeductionStatus @default(pending) @map("inventory_deduction_status")
  isOfflineTransaction        Boolean                  @default(false) @map("is_offline_transaction")
  offlineProvisionalNumber    String?                  @map("offline_provisional_number")
  syncedAt                    DateTime?                @map("synced_at")
  receiptPrinted              Boolean                  @default(false) @map("receipt_printed")
  voidedAt                    DateTime?                @map("voided_at")
  voidedById                  String?                  @map("voided_by_id")
  voidReason                  String?                  @map("void_reason")
  refundedAt                  DateTime?                @map("refunded_at")
  refundedById                String?                  @map("refunded_by_id")
  refundReason                String?                  @map("refund_reason")

  branch                 Branch            @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift                  Shift?            @relation(fields: [shiftId], references: [id])
  cashier                User              @relation(fields: [cashierId], references: [id])
  voidedBy               User?             @relation("TransactionVoidedBy", fields: [voidedById], references: [id])
  refundedBy             User?             @relation("TransactionRefundedBy", fields: [refundedById], references: [id])
  paymentProofVerifiedBy User?             @relation("TransactionPaymentProofVerifiedBy", fields: [paymentProofVerifiedById], references: [id])
  items                  TransactionItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([branchId, createdAt])
  @@index([shiftId])
  @@index([cashierId])
  @@index([discountCustomerIdHash])
  @@map("transactions")
}

/// Snapshot fields freeze the product/variant/flavor name and price at the
/// exact moment of sale — they never change even if the product catalog
/// or pricing changes later.
model TransactionItem {
  id                  String  @id @default(uuid())
  transactionId       String  @map("transaction_id")
  productId           String  @map("product_id")
  productVariantId    String  @map("product_variant_id")
  flavorId            String? @map("flavor_id")
  productNameSnapshot String  @map("product_name_snapshot")
  variantNameSnapshot String  @map("variant_name_snapshot")
  flavorNameSnapshot  String? @map("flavor_name_snapshot")
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity            Int
  lineTotal           Decimal @map("line_total") @db.Decimal(10, 2)
  // CR-004: the master Recipe.version(s) in effect for this line's deduction
  // at sale time — a frozen snapshot, same reasoning as the name/price
  // snapshot fields above. Defaults to 1 for historical rows predating this
  // column.
  recipeVersion       Int     @default(1) @map("recipe_version")
  // CR-005 Phase 1: multi-slot flavor selections (Product Builder). Snapshot
  // JSON, same freezing rationale as the name/price snapshot fields above.
  selectedFlavors     Json?   @map("selected_flavors")
  // Sale-time snapshot of the exact deduction lines computeDeduction()
  // produced for this line item, captured before inventory was deducted:
  // [{ ingredientId, ingredientName, quantity, unit }]. Null for rows
  // written before this column existed; recipeVersion remains the
  // backward-compatible fallback for those. Additive alongside
  // recipeVersion, not a replacement.
  deductionSnapshot   Json?   @map("deduction_snapshot")
  // Task 93: sale-time snapshot of the Product Options selected for this
  // line, e.g. [{ option_id, option_name, option_group_id,
  // option_group_name, price_adjustment }] — frozen at checkout, same
  // freezing rationale as the other snapshot fields above. price_adjustment
  // here is the trusted DB value resolveSelectedOptionsPremium validated,
  // never the frontend-submitted display price. Null for rows with no
  // selected options (or written before this column existed).
  selectedOptions     Json?   @map("selected_options")

  transaction    Transaction    @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  flavor         Flavor?        @relation(fields: [flavorId], references: [id])

  @@index([transactionId])
  @@index([productVariantId])
  @@map("transaction_items")
}

model Shift {
  id                     String      @id @default(uuid())
  branchId               String      @map("branch_id")
  cashierId              String      @map("cashier_id")
  openedBy               String      @map("opened_by")
  closedBy               String?     @map("closed_by")
  status                 ShiftStatus @default(active)
  openingCashAmount      Decimal     @map("opening_cash_amount") @db.Decimal(10, 2)
  closingCashAmount      Decimal?    @map("closing_cash_amount") @db.Decimal(10, 2)
  expectedClosingCash    Decimal?    @map("expected_closing_cash") @db.Decimal(10, 2)
  cashVariance           Decimal?    @map("cash_variance") @db.Decimal(10, 2)
  // Tri-state: null = no variance / not yet reviewed, true = approved, false = rejected.
  varianceApproved       Boolean?    @map("variance_approved")
  // Cashier's own explanation, entered at close time when the variance is outside tolerance.
  varianceExplanation    String?     @map("variance_explanation")
  // Super Admin's justification when approving or rejecting — distinct from the cashier's explanation above.
  varianceApprovedBy     String?     @map("variance_approved_by")
  varianceApprovalReason String?     @map("variance_approval_reason")
  cashSalesTotal         Decimal     @default(0) @map("cash_sales_total") @db.Decimal(10, 2)
  gcashSalesTotal        Decimal     @default(0) @map("gcash_sales_total") @db.Decimal(10, 2)
  mayaSalesTotal         Decimal     @default(0) @map("maya_sales_total") @db.Decimal(10, 2)
  mayaSalesCount         Int         @default(0) @map("maya_sales_count")
  otherSalesTotal        Decimal     @default(0) @map("other_sales_total") @db.Decimal(10, 2)
  otherSalesCount        Int         @default(0) @map("other_sales_count")
  grossSalesTotal        Decimal     @default(0) @map("gross_sales_total") @db.Decimal(10, 2)
  transactionCount       Int         @default(0) @map("transaction_count")
  shiftNotes             String?     @map("shift_notes")
  cashSalesCount         Int         @default(0) @map("cash_sales_count")
  gcashSalesCount        Int         @default(0) @map("gcash_sales_count")
  voidedCount            Int         @default(0) @map("voided_count")
  refundedCount          Int         @default(0) @map("refunded_count")
  totalTransactionCount  Int         @default(0) @map("total_transaction_count")
  totalDiscountAmount    Decimal     @default(0) @map("total_discount_amount") @db.Decimal(10, 2)
  pwdScTransactionCount  Int         @default(0) @map("pwd_sc_transaction_count")

  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cashier User   @relation("ShiftCashier", fields: [cashierId], references: [id])
  opener  User   @relation("ShiftOpenedBy", fields: [openedBy], references: [id])

  denominations ShiftCashDenomination[]
  transactions  Transaction[]
  holdOrders    HoldOrder[]
  reviews       ShiftReview[]

  startedAt DateTime  @map("started_at")
  closedAt  DateTime? @map("closed_at")

  @@index([branchId])
  @@index([branchId, status])
  @@index([cashierId])
  @@index([openedBy])
  @@map("shifts")
}

enum ShiftReviewPhase {
  opening
  closing
}

enum ShiftReviewStatus {
  pending
  approved
  rejected
}

/// Opening/Closing shift review approval (Production Stabilization sprint,
/// 2026-07) — deliberately distinct from Shift.varianceApproved/
/// varianceApprovedBy/varianceApprovalReason above, which already cover cash
/// variance review end-to-end. Exactly two rows per shift (one per phase,
/// enforced by @@unique below), both created as 'pending' when the shift is
/// opened — so a "pending reviews" queue is a plain status filter, never an
/// anti-join against shifts with no row yet.
model ShiftReview {
  id         String            @id @default(uuid())
  shiftId    String            @map("shift_id")
  phase      ShiftReviewPhase
  status     ShiftReviewStatus @default(pending)
  reviewedBy String?           @map("reviewed_by")
  reviewedAt DateTime?         @map("reviewed_at")
  notes      String?

  shift    Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ShiftReviewReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([shiftId, phase])
  @@index([shiftId])
  @@index([status])
  @@index([phase])
  @@index([reviewedBy])
  @@index([createdAt])
  @@map("shift_reviews")
}

/// Architecture doc §Part 8 "Hold orders": max 3 per terminal, 15-min expiry,
/// non-blocking toast on expiry, no supervisor action required. No separate
/// "terminal" entity exists in this schema — a cashier's active Shift is the
/// closest real proxy for one POS terminal session, so holds are scoped to
/// shiftId (the 3-per-terminal limit is enforced as 3-per-active-shift).
model HoldOrder {
  id         String          @id @default(uuid())
  branchId   String          @map("branch_id")
  shiftId    String          @map("shift_id")
  cashierId  String          @map("cashier_id")
  status     HoldOrderStatus @default(held)
  expiresAt  DateTime        @map("expires_at")
  releasedAt DateTime?       @map("released_at")
  expiredAt  DateTime?       @map("expired_at")

  branch  Branch          @relation(fields: [branchId], references: [id], onDelete: Cascade)
  shift   Shift           @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  cashier User            @relation(fields: [cashierId], references: [id])
  items   HoldOrderItem[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([shiftId, status])
  @@index([branchId, status])
  @@map("hold_orders")
}

/// Cart line snapshot at hold time — mirrors TransactionItem's snapshot
/// fields (name/price frozen at hold time) so a held order's display never
/// silently drifts if the catalog changes while it's on hold.
model HoldOrderItem {
  id                  String  @id @default(uuid())
  holdOrderId         String  @map("hold_order_id")
  productId           String  @map("product_id")
  productVariantId    String  @map("product_variant_id")
  flavorId            String? @map("flavor_id")
  productNameSnapshot String  @map("product_name_snapshot")
  variantNameSnapshot String  @map("variant_name_snapshot")
  flavorNameSnapshot  String? @map("flavor_name_snapshot")
  unitPriceSnapshot   Decimal @map("unit_price_snapshot") @db.Decimal(10, 2)
  quantity            Int

  holdOrder      HoldOrder      @relation(fields: [holdOrderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  flavor         Flavor?        @relation(fields: [flavorId], references: [id])

  @@index([holdOrderId])
  @@map("hold_order_items")
}

model ShiftCashDenomination {
  id           String                @id @default(uuid())
  shiftId      String                @map("shift_id")
  denomination Decimal               @db.Decimal(10, 2)
  count        Int
  totalValue   Decimal               @map("total_value") @db.Decimal(10, 2)
  countType    DenominationCountType @map("count_type")

  shift Shift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId, countType])
  @@map("shift_cash_denominations")
}

